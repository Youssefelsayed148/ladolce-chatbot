# Copy this file to .env and fill in the real values. Never commit .env.
# One command then runs everything:  docker compose up -d --build
# ------------------------------------------------------------------------------

# development | production (shown by /api/health)
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Public address ---
# The domain whose DNS A record points at this server. Caddy gets a Let's Encrypt
# certificate for it automatically (ports 80 and 443 must be open).
# DOMAIN=localhost serves a local self-signed certificate for testing.
DOMAIN=chat.example.com
# Host ports (change only if 80/443 are taken, e.g. HTTP_PORT=8080 HTTPS_PORT=8443)
HTTP_PORT=80
HTTPS_PORT=443

# --- Postgres ---
POSTGRES_USER=ladolce
# Use a strong password, and the SAME one inside DATABASE_URL (avoid : / @ # in it).
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=ladolce
# Host is the compose service name `db`. +asyncpg is the app driver (Alembic swaps it).
DATABASE_URL=postgresql+asyncpg://ladolce:change-me-to-a-long-random-password@db:5432/ladolce

# --- Embeddings (knowledge base search) - always OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chat model: switch provider by changing ONLY these three values ---
# OpenRouter + GLM (tested):
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-openrouter-key-here
LLM_MODEL=z-ai/glm-4.7
# OpenAI instead (tested):
#   LLM_API_BASE=https://api.openai.com/v1
#   LLM_API_KEY=<your OpenAI key>
#   LLM_MODEL=gpt-4o
# Do NOT use OpenCode Go: it rejects server-side calls (400 MissingSessionID).

# Follow-up suggestion chips cost one extra LLM call per message; false saves quota.
SUGGESTIONS_ENABLED=true

# --- CORS: the exact site origin(s) that embed the widget ---
CORS_ORIGINS=https://ladolcesaveur.com,https://www.ladolcesaveur.com

# --- Rate limit for the public /api/chat endpoint (slowapi syntax) ---
CHAT_RATE_LIMIT=20/minute

# --- Client store (catalog/quote reads, and where the guest finishes checkout) ---
STORE_API_BASE=https://ladolce.theosirislabs.com
STORE_CHECKOUT_URL=https://ladolcesaveur.com/checkout
