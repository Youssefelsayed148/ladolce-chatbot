# Copy this file to .env and fill in real values. Do NOT commit .env.
# ------------------------------------------------------------------------------

# Runtime environment: development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (consumed by the db container) ---
POSTGRES_USER=ladolce
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=ladolce

# --- Database URL (consumed by the api container and Alembic) ---
# Async driver (+asyncpg) for the app; Alembic swaps it to +psycopg internally.
# Host is the compose service name `db`.
DATABASE_URL=postgresql+asyncpg://ladolce:change-me-in-real-deployments@db:5432/ladolce

# --- OpenAI (kept for embeddings/RAG and as a revert path; see audit) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
# Used by search_knowledge_base retrieval and scripts/ingest_kb.py. Must match
# kb_chunks.embedding's vector(1536) dimension if ever changed.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- OpenCode Go (active provider for chat / tool-calling) ---
LLM_PROVIDER=opencodego
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-your-opencode-go-key-here
# Default chat model: Kimi K2.7 Code is the strongest OpenAI-compatible
# tool-caller in the Go lineup at a moderate price point.
LLM_MODEL=glm-4.7

# --- CORS: comma-separated origins allowed to call the API from a browser ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Rate limit for the public /api/chat endpoint (slowapi syntax) ---
CHAT_RATE_LIMIT=20/minute
