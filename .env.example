# Copy this file to .env and fill in real values. Do NOT commit .env.
# ------------------------------------------------------------------------------

# Runtime environment: development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (consumed by the db container) ---
POSTGRES_USER=ladolce
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=ladolce

# --- Database URL (consumed by the api container and Alembic) ---
# Async driver (+asyncpg) for the app; Alembic swaps it to +psycopg internally.
# Host is the compose service name `db`.
DATABASE_URL=postgresql+asyncpg://ladolce:change-me-in-real-deployments@db:5432/ladolce

# --- Embeddings (knowledge base search + scripts/ingest_kb.py) ---
# Always OpenAI, whichever chat provider is active below. Cost is cents/month.
# Must match kb_chunks.embedding's vector(1536) dimension if ever changed.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chat model (switch providers by changing ONLY these three values) ---
# OpenCode Go rejects server-side calls (400 MissingSessionID) - do not use it here.
# OpenRouter (GLM etc.): LLM_API_BASE=https://openrouter.ai/api/v1
# Free tier (OpenCode, only if it starts accepting server calls):
LLM_API_BASE=https://opencode.ai/zen/go/v1
LLM_API_KEY=sk-your-opencode-key-here
LLM_MODEL=glm-4.7
# OpenAI instead:
#   LLM_API_BASE=https://api.openai.com/v1
#   LLM_API_KEY=<your OpenAI key>
#   LLM_MODEL=gpt-4o

# Follow-up suggestion chips use one extra LLM call per message; set false to save quota.
SUGGESTIONS_ENABLED=true

# --- CORS: comma-separated origins allowed to call the API from a browser ---
# Production: https://ladolcesaveur.com,https://www.ladolcesaveur.com
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Rate limit for the public /api/chat endpoint (slowapi syntax) ---
CHAT_RATE_LIMIT=20/minute

# --- Client store (read-only catalog/quote + where the guest finishes checkout) ---
STORE_API_BASE=https://ladolce.theosirislabs.com
STORE_CHECKOUT_URL=https://ladolcesaveur.com/checkout
